-- =============================================================================
-- Credential test helpers (include after _helpers.psql). Every step uses the
-- real RPCs as the acting user; only the malware-scanner step runs as the
-- owner role (it is the scanner's operator procedure).
-- =============================================================================

-- Creates a credential (+ version 1 draft) as the user. Returns {credential_id, credential_version_id}.
create function pg_temp.new_credential(
  p_user uuid, p_type text, p_jurisdiction text, p_number text, p_issue date, p_expiry date
) returns jsonb language sql as $$
  select pg_temp.query_as(p_user, 'aal1', format(
    'select * from public.create_credential(%L, %L, %L, %L, %L::date, %L::date)',
    p_type, p_jurisdiction, 'Issuing Board', p_number, p_issue, p_expiry)) -> 0
$$;

create function pg_temp.share_credential(p_user uuid, p_credential uuid, p_org uuid)
returns uuid language sql as $$
  select pg_temp.scalar_as(p_user, 'aal1', format('select public.share_credential(%L, %L)', p_credential, p_org))::uuid
$$;

-- Begins an upload as the owner, places the object in Storage (owner role, as the
-- Storage API would), and completes it with a content check result.
create function pg_temp.upload_document(p_user uuid, p_version uuid, p_valid boolean default true)
returns uuid language plpgsql as $$
declare
  v_doc jsonb;
begin
  v_doc := pg_temp.query_as(p_user, 'aal1', format(
    'select * from public.begin_credential_document_upload(%L, ''application/pdf'', 2048)', p_version)) -> 0;
  insert into storage.objects (bucket_id, name, owner, metadata)
  values ('credential-documents', v_doc ->> 'object_path', p_user, '{"mimetype":"application/pdf","size":2048}');
  perform pg_temp.scalar_as(p_user, 'aal1', format(
    'select public.complete_credential_document_upload(%L, %L, %L)',
    v_doc ->> 'document_id', repeat('a', 64), p_valid));
  return (v_doc ->> 'document_id')::uuid;
end;
$$;

-- Scanner / operator: mark a document clean (or quarantined).
create function pg_temp.scan(p_document uuid, p_result text default 'clean')
returns void language sql as $$
  select internal.record_document_scan_result(p_document, p_result::public.document_status)
$$;

create function pg_temp.submit(p_user uuid, p_version uuid)
returns void language sql as $$
  select pg_temp.exec_as(p_user, 'aal1', format('select public.submit_credential_version(%L)', p_version))
$$;

-- Full evidence: credential + clean document + submitted. Returns {credential_id, credential_version_id}.
create function pg_temp.evidence(
  p_user uuid, p_type text, p_jurisdiction text, p_number text, p_issue date, p_expiry date
) returns jsonb language plpgsql as $$
declare
  v_created jsonb := pg_temp.new_credential(p_user, p_type, p_jurisdiction, p_number, p_issue, p_expiry);
  v_requires_document boolean;
begin
  select requires_document into v_requires_document from public.credential_types where key = p_type;
  if v_requires_document then
    perform pg_temp.scan(pg_temp.upload_document(p_user, (v_created ->> 'credential_version_id')::uuid));
  end if;
  perform pg_temp.submit(p_user, (v_created ->> 'credential_version_id')::uuid);
  return v_created;
end;
$$;

create function pg_temp.verify(
  p_actor uuid, p_version uuid, p_org uuid, p_outcome text default 'verified',
  p_reason text default null, p_facility uuid default null
) returns uuid language sql as $$
  select pg_temp.scalar_as(p_actor, 'aal2', format(
    'select public.record_credential_verification(%L, %L, %L, %L, %L)',
    p_version, p_org, p_outcome, p_reason, p_facility))::uuid
$$;

-- Compliance as a map {type | 'facility:'type | 'worker:REASON' → reason}.
create function pg_temp.reasons(p_user uuid, p_worker uuid, p_facility uuid default null, p_as_of date default current_date)
returns jsonb language sql as $$
  select coalesce(jsonb_object_agg(
    case when x ->> 'requirement_scope' = 'facility' then 'facility:' || (x ->> 'credential_type_key')
         else coalesce(x ->> 'credential_type_key', 'worker:' || (x ->> 'reason')) end,
    x ->> 'reason'), '{}'::jsonb)
  from jsonb_array_elements(pg_temp.query_as(p_user, 'aal1', format(
    'select * from public.evaluate_worker_compliance(%L, %L, %L::date)', p_worker, p_facility, p_as_of))) x
$$;

create function pg_temp.readiness(p_user uuid, p_worker uuid, p_facility uuid default null, p_as_of date default current_date)
returns text language sql as $$
  select pg_temp.query_as(p_user, 'aal1', format(
    'select readiness from public.worker_readiness(%L, %L, %L::date)', p_worker, p_facility, p_as_of)) -> 0 ->> 'readiness'
$$;

create function pg_temp.worker_of(p_org uuid, p_user uuid)
returns uuid language sql as $$
  select id from public.agency_workers
  where agency_organisation_id = p_org and profile_id = p_user and status <> 'terminated'
$$;
