# ---------------------------------------------------------------------------
# Chelth environment template.
#
# Copy to .env.local for local development:  cp .env.example .env.local
# Never commit real values. .env.local is git-ignored.
# Production/preview values live in the Vercel project settings only.
# ---------------------------------------------------------------------------

# --- Public (inlined into browser bundles — NEVER put secrets here) ---------

# development | test | preview | production
# If unset: derived from VERCEL_ENV, otherwise NODE_ENV. A production build
# with no hint resolves to "production" and enforces production rules
# (https, non-local Supabase URL).
NEXT_PUBLIC_APP_ENV=development

# Local Supabase (from `npm run db:start` output). Chelth uses non-default
# local ports (553xx) so it can run alongside other local Supabase projects.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
# The anon / publishable key ONLY. A service-role or sb_secret_ key here is
# rejected by environment validation.
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key-from-supabase-status

# --- Server-only (never prefixed NEXT_PUBLIC_) -------------------------------

# debug | info | warn | error   (default: info)
LOG_LEVEL=debug

# Transactional email: disabled | resend  (default: disabled)
# With "disabled", invitation links are shown once to the issuer instead of emailed.
EMAIL_PROVIDER=disabled
# Required only when EMAIL_PROVIDER=resend. Server-only; never NEXT_PUBLIC_.
# RESEND_API_KEY=
# EMAIL_FROM="CHELTH <no-reply@mail.your-domain.example>"

# Notification delivery (docs/architecture/NOTIFICATION_DELIVERY.md). Optional;
# without all three the dispatch route answers "not configured".
# Canonical app origin for email links (https outside local development).
# APP_BASE_URL=http://localhost:3000
# Bearer secret presented by the scheduler (>= 32 chars). Server-only.
# NOTIFICATION_DISPATCH_SECRET=
# LOGIN role that is a member of chelth_notification_worker (claim/complete only).
# NOTIFICATION_WORKER_DATABASE_URL=postgresql://chelth_notifier:<password>@127.0.0.1:55322/postgres

# Reserved for future error monitoring. Leave empty until Sentry is approved.
# SENTRY_DSN=
